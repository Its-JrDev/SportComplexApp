{
  "name": "sportcomplex-monorepo",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines"
    ]
  },
  "description": "Plataforma de Gestión de Reservas, Venta y Control de Acceso Deportivo (SportComplex) — Monorepo Turborepo + pnpm",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "22.14.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "turbo": "2.11.4",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "lucide-react": "^1.50.0"
  }
}
